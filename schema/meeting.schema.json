{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/michael-rechberger/commonmind-llm-wiki/main/schema/meeting.schema.json",
  "title": "Commonmind meeting file frontmatter",
  "description": "Frontmatter of a meeting file in sources/meetings/ (Commonmind 1.0, section 9.3).",
  "type": "object",
  "required": [
    "type",
    "title",
    "date",
    "owner"
  ],
  "properties": {
    "type": {
      "enum": [
        "agenda",
        "minutes"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "$ref": "page.schema.json#/$defs/timestamp"
    },
    "owner": {
      "$ref": "page.schema.json#/$defs/actor"
    },
    "data_class": {
      "$ref": "page.schema.json#/$defs/identifier"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/.+\\.md$"
      }
    },
    "verified": {
      "$ref": "page.schema.json#/$defs/verified"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "agenda"
          }
        }
      },
      "then": {
        "properties": {
          "verified": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
